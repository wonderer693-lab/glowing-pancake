---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Page not found" description="The page you are looking for does not exist or has been moved. Try the homepage or contact the writer." noindex>
  <div class="wrap a404">
    <h1>404</h1>
    <p>The page you wanted is not here. Maybe a slug got changed. Maybe I deleted something dumb.</p>
    <p><a href="/">Start over from the homepage</a> or <a href="/contact/">email me</a> the broken link.</p>
  </div>
</BaseLayout>